{
  "manifest_version": 3,
  "name": "DB Merge Tool",
  "version": "1.0",
  "description": "Giao diện cấu hình và kích hoạt quá trình merge database.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DB Merge Tool"
  },
  "permissions": [],
  "host_permissions": [
    "https://*.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
